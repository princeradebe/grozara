# Copy to .env (git-ignored) and fill in.
# API key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Zara's voice: a South African voice in your ElevenLabs library. `pnpm voices` shortlists some.
ELEVENLABS_VOICE_ID=
# Optional. eleven_v3 is the most expressive; eleven_multilingual_v2 (the default) is steadier.
ELEVENLABS_MODEL=
